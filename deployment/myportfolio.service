[Unit]
Description=Serve Portfolio Site
After=network.target mysqld.service
Requires=mysqld.service

[Service]
User=root
Group=root
WorkingDirectory=/root/pe-portfolio-site
EnvironmentFile=/root/pe-portfolio-site/.env
Environment=FLASK_APP=app
ExecStart=/root/pe-portfolio-site/python3-virtualenv/bin/python -m flask run --host=0.0.0.0 --port=5000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
